{
  "name": "arena-site-src",
  "private": true,
  "version": "0.0.0",
  "description": "Build-time only: compiles the arena site's Tailwind CSS and copies its fonts. The output is committed.",
  "scripts": {
    "build": "tailwindcss -i input.css -o ../arena/site/css/site.css --minify && node scripts/copy-fonts.mjs",
    "check": "node scripts/check-build.mjs"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
